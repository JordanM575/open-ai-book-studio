# Copy this file to `.env.local` and fill in only the keys you actually have.
# `.env.local` is ignored by git. Never commit a real key, never paste one into an issue,
# a screenshot, a fixture or a release artifact.

# OpenRouter — optional for development if you use the in-app "Connect OpenRouter" flow.
# A key here is only used by scripts, live tests and CI.
OPENROUTER_API_KEY=

# Direct provider keys. Each unlocks its adapter and its live check.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# Meta's current OpenAI-compatible endpoint. The base URL is required because Meta has
# retired hosted endpoints before; copy it from the Meta developer console.
META_API_KEY=
META_API_BASE_URL=

# Optional, for the voice and illustration work in spec 002.
ELEVENLABS_API_KEY=

# Set to 1 to let the live provider checks run. Without it they skip cleanly.
LIVE_PROVIDER_TESTS=

# Per-run spend ceiling for live checks, in US cents.
LIVE_SPEND_CAP_CENTS=5
