{
  "name": "@ai-book-studio/ui",
  "version": "0.1.0",
  "private": true,
  "description": "Shared React components and styles for every AI Book Studio target",
  "license": "Apache-2.0",
  "type": "module",
  "imports": {
    "#components/*": "./src/components/*.tsx",
    "#ai-elements/*": "./src/ai-elements/*.tsx",
    "#hooks/*": "./src/hooks/*.ts",
    "#lib/*": "./src/lib/*.ts"
  },
  "exports": {
    "./button": {
      "types": "./src/components/button.tsx",
      "default": "./src/components/button.tsx"
    },
    "./dialog": {
      "types": "./src/components/dialog.tsx",
      "default": "./src/components/dialog.tsx"
    },
    "./brand": {
      "types": "./src/components/brand.tsx",
      "default": "./src/components/brand.tsx"
    },
    "./notice": {
      "types": "./src/components/notice.tsx",
      "default": "./src/components/notice.tsx"
    },
    "./components/*": {
      "types": "./src/components/*.tsx",
      "default": "./src/components/*.tsx"
    },
    "./ai-elements/*": {
      "types": "./src/ai-elements/*.tsx",
      "default": "./src/ai-elements/*.tsx"
    },
    "./hooks/*": {
      "types": "./src/hooks/*.ts",
      "default": "./src/hooks/*.ts"
    },
    "./lib/*": {
      "types": "./src/lib/*.ts",
      "default": "./src/lib/*.ts"
    },
    "./styles/*": {
      "default": "./src/styles/*"
    },
    "./utils": {
      "types": "./src/lib/utils.ts",
      "default": "./src/lib/utils.ts"
    }
  },
  "dependencies": {
    "@shadcn/react": "^0.3.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.61.0",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "typescript": "^7.0.2"
  }
}
