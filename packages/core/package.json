{
  "name": "@ai-book-studio/core",
  "version": "0.1.0",
  "private": true,
  "description": "Schemas, book format and IPC contract shared by every build",
  "license": "Apache-2.0",
  "type": "module",
  "exports": {
    "./planning/schema": {
      "types": "./src/planning/schema.ts",
      "default": "./src/planning/schema.ts"
    },
    "./planning/service": {
      "types": "./src/planning/service.ts",
      "default": "./src/planning/service.ts"
    },
    "./planning/checked-sidecar": {
      "types": "./src/planning/checked-sidecar.ts",
      "default": "./src/planning/checked-sidecar.ts"
    },
    "./organization/goals": {
      "types": "./src/organization/goals.ts",
      "default": "./src/organization/goals.ts"
    },
    "./schema": {
      "types": "./src/schema.ts",
      "default": "./src/schema.ts"
    },
    "./build": {
      "types": "./src/build.ts",
      "default": "./src/build.ts"
    },
    "./licenses": {
      "types": "./src/licenses.ts",
      "default": "./src/licenses.ts"
    },
    "./ipc": {
      "types": "./src/ipc.ts",
      "default": "./src/ipc.ts"
    },
    "./markdown": {
      "types": "./src/markdown.ts",
      "default": "./src/markdown.ts"
    },
    "./manuscript-import": {
      "types": "./src/manuscript-import/index.ts",
      "default": "./src/manuscript-import/index.ts"
    },
    "./manuscript-import/docx": {
      "types": "./src/manuscript-import/docx.ts",
      "default": "./src/manuscript-import/docx.ts"
    },
    "./speech-text": {
      "types": "./src/speech-text.ts",
      "default": "./src/speech-text.ts"
    },
