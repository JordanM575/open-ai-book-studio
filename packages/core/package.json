      "types": "./src/review/index.ts",
      "default": "./src/review/index.ts"
    },
    "./review/*": {
      "types": "./src/review/*.ts",
      "default": "./src/review/*.ts"
    },
    "./agent": {
      "types": "./src/agent.ts",
      "default": "./src/agent.ts"
    },
    "./agent/*": {
      "types": "./src/agent/*.ts",
      "default": "./src/agent/*.ts"
    },
    "./matter": {
      "types": "./src/matter.ts",
      "default": "./src/matter.ts"
    },
    "./legacy": {
      "types": "./src/legacy.ts",
      "default": "./src/legacy.ts"
    },
    "./providers/*": {
      "types": "./src/providers/*.ts",
      "default": "./src/providers/*.ts"
    },
    "./routing": {
      "types": "./src/routing/index.ts",
      "default": "./src/routing/index.ts"
    },
    "./routing/*": {
      "types": "./src/routing/*.ts",
      "default": "./src/routing/*.ts"
    },
    "./images": {
      "types": "./src/images/index.ts",
      "default": "./src/images/index.ts"
    },
    "./images/*": {
      "types": "./src/images/*.ts",
      "default": "./src/images/*.ts"
    },
    "./library/*": {
      "types": "./src/library/*.ts",
      "default": "./src/library/*.ts"
    },
    "./archive/*": {
      "types": "./src/archive/*.ts",
      "default": "./src/archive/*.ts"
    },
    "./sync": {
      "types": "./src/sync/index.ts",
      "default": "./src/sync/index.ts"
    },
    "./sync/*": {
      "types": "./src/sync/*.ts",
      "default": "./src/sync/*.ts"
    },
    "./words": {
      "types": "./src/words.ts",
      "default": "./src/words.ts"
    },
    "./paste": {
      "types": "./src/paste.ts",
      "default": "./src/paste.ts"
    }
