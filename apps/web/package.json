{
  "name": "@ai-book-studio/web",
  "version": "0.1.0",
  "private": true,
  "description": "Browser build and storage adapters for AI Book Studio",
  "license": "Apache-2.0",
  "type": "module",
  "exports": {
    "./storage/*": {
      "types": "./src/storage/*.ts",
      "default": "./src/storage/*.ts"
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "build:check": "bun build check/main.ts check/restart.ts --outdir check/dist --target browser --format esm",
    "build:gallery": "vite build --config vite.gallery.config.ts",
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview"
  },
  "dependencies": {
    "@ai-book-studio/app": "workspace:*",
    "@ai-book-studio/core": "workspace:*",
    "@ai-book-studio/ui": "workspace:*",
    "@radix-ui/react-dialog": "^1.3.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.61.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@happy-dom/global-registrator": "^21.0.4",
    "@tailwindcss/vite": "^4.3.3",
    "@types/bun": "^1.4.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "fake-indexeddb": "^6.2.6",
    "fflate": "^0.8.3",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.0",
    "vite": "^8.3.5"
  }
}
