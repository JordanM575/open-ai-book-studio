{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": [
      "ES2023",
      "DOM",
      "DOM.Iterable"
    ],
    "jsx": "react-jsx",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "noEmit": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true
  },
  "include": [
    "src/renderer/src/**/*.ts",
    "src/renderer/src/**/*.tsx",
    "src/preload/index.d.ts",
    "tests/manuscript-editor.test.ts",
    "tests/review-gate.test.tsx",
    "tests/review-report.test.tsx",
    "tests/story-bible-dialog.test.tsx",
    "tests/settings-status.test.tsx",
    "tests/dictation-hook.test.ts",
    "tests/ambient-panel.test.ts",
    "tests/notice.test.tsx",
    "tests/error-boundary.test.tsx",
    "tests/manuscript-import-preview.test.tsx",
    "tests/manuscript-import-journey.test.tsx",
    "tests/library-health.test.tsx",
    "tests/placeholder-save.test.tsx",
    "tests/format-dialog.test.tsx",
    "tests/docx-export-flush.test.tsx",
    "tests/book-actions-images.test.tsx",
    "tests/settings-about.test.tsx",
    "tests/schema-refusal.test.tsx",
    "tests/agent-tone.test.tsx",
    "tests/agent-spending.test.tsx",
    "tests/agent-limits-contract.test.ts",
    "tests/drift-report.test.tsx",
    "tests/sync-section.test.tsx",
    "tests/task-preview.test.tsx",
    "tests/task-preview-states.test.tsx",
    "tests/task-preview-neutrality.test.tsx",
    "tests/task-preview-calls.test.tsx",
    "tests/task-preview-consent.test.tsx",
    "tests/task-preview-access.test.tsx",
    "tests/chapter-read-issues.test.tsx",
    "tests/chapter-rail.test.tsx",
    "tests/chapter-reorder-conflict.test.tsx",
    "tests/chat-composer.test.tsx",
    "tests/connection-cards.test.tsx",
    "tests/licenses-dialog.test.tsx",
    "tests/book-dialogs.test.tsx",
    "tests/review-gate-blocked.test.tsx",
    "tests/support/dom.ts"
  ]
}
