{
  "name": "@ai-book-studio/toolkit",
  "version": "0.1.0",
  "private": true,
  "description": "Standalone CLI and MCP server for an open Open Book Studio library",
  "license": "Apache-2.0",
  "type": "module",
  "bin": {
    "bookwriter": "./src/cli.ts"
  },
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "bun build ./src/cli.ts --target=bun --outfile=dist/bookwriter --minify",
    "start": "bun ./src/cli.ts"
  },
  "dependencies": {
    "@ai-book-studio/core": "workspace:*"
  },
  "devDependencies": {
    "@types/bun": "^1.4.4",
    "@types/node": "^26.6.5",
    "typescript": "^7.0.2"
  }
}
